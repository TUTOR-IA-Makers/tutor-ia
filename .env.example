# CodeExpert configuration.
#
#   cp .env.example .env    and fill in CODEEXPERT_LLM_API_KEY
#
# Every setting is also readable from the real environment, which is how
# CI and any deployment should supply them. `.env` is git-ignored: never
# commit a filled-in copy.

# ── LLM provider (OpenAI-compatible chat completions) ─────────────────────────
CODEEXPERT_LLM_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXX
CODEEXPERT_LLM_MODEL=gpt-4o-mini
CODEEXPERT_LLM_BASE_URL=https://api.openai.com/v1
CODEEXPERT_LLM_TIMEOUT_SECONDS=60
CODEEXPERT_LLM_MAX_RETRIES=3

# ── Filesystem ────────────────────────────────────────────────────────────────
# Both live under var/, which is git-ignored. One directory per generation run.
CODEEXPERT_WORKSPACE_ROOT=var/runs
CODEEXPERT_QUESTIONS_DIR=var/questions

# ── Local execution limits ────────────────────────────────────────────────────
# These are resource limits, NOT a sandbox. See docs/adr/0004.
CODEEXPERT_COMPILE_TIMEOUT_SECONDS=20
CODEEXPERT_RUN_TIMEOUT_SECONDS=5
CODEEXPERT_RUN_MAX_OUTPUT_BYTES=65536
