# /opt/codeexpert/production.env on the VPS — read by `docker compose --env-file`.
# Nothing here is a secret: the LLM key and the database password are files under
# /etc/codeexpert/secrets (see bootstrap-vps.sh). Fake values only in this copy.

# Image pushed by .github/workflows/deploy.yml. Lower case: GHCR requires it.
IMAGE=ghcr.io/tutor-ia-makers/codeexpert

# The domain whose A record points at the VPS. Caddy gets its certificate.
DOMAIN=codeexpert.example.com

# Basic auth until G8-1. Generate the hash with:
#   docker run --rm caddy:2.8 caddy hash-password
# Keep the SINGLE quotes: the bcrypt hash contains `$`, which Compose would
# otherwise try to expand as a variable.
BASIC_AUTH_USER=equipe
BASIC_AUTH_HASH='$2a$14$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
